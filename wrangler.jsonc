{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sermon-research",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Wrangler creates this database on first deploy when it does not exist yet.
  // The Worker applies its own schema on the first request, so no migration
  // command is needed. See AGENTS.md if your Wrangler version asks for an id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sermon-research"
    }
  ],
  // Create once before the first deploy (see AGENTS.md):
  //   npx wrangler vectorize create sermon-research --dimensions=1536 --metric=cosine
  //   npx wrangler vectorize create-metadata-index sermon-research --property-name=episodeId --type=string
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "sermon-research"
    }
  ],
  // Episode audio, copied from the feed so transcription and the episode
  // player don't depend on the church's own site. The Deploy workflow (or
  // Wrangler's automatic provisioning) creates the bucket.
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "sermon-research-audio"
    }
  ],
  // One run per episode: transcribe, summarize, index. Each step retries on its own.
  "workflows": [
    {
      "name": "sermon-research-episode",
      "binding": "EPISODE_WORKFLOW",
      "class_name": "EpisodeWorkflow"
    }
  ],
  // Hourly tick. The Worker reads the church's schedule from the database and
  // only checks the feed when it is due, so the schedule never needs editing here.
  "triggers": {
    "crons": ["0 * * * *"]
  }
  // APP_SECRET is a secret, not a var: `npx wrangler secret put APP_SECRET`.
}
