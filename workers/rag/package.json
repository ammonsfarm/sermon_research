{
  "name": "@aic/rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private authenticated RAG Worker and orchestration service",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface RagWorkerEnv cloudflare-env.d.ts --config wrangler.jsonc",
    "check:cf-typegen": "wrangler types --env-interface RagWorkerEnv .cloudflare-env.check.d.ts --config wrangler.jsonc && node scripts/check-typegen.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aic/ai": "0.1.0",
    "@aic/auth": "0.1.0",
    "@aic/contracts": "0.1.0",
    "@aic/db": "0.1.0",
    "@aic/observability": "0.1.0",
    "@clerk/backend": "3.16.6"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "wrangler": "4.123.0"
  }
}
